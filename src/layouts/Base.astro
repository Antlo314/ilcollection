---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

import cormorant300 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import jostVar from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import { graph, webPage, abs } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  /** Share image (site-relative or absolute); 1200×630 works best. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Open Graph type */
  type?: 'website' | 'product' | 'article';
  /** Extra schema.org nodes for this page (merged into the site graph). */
  schema?: unknown[];
  /** schema.org WebPage subtype for this page */
  pageType?: string;
  /** Product price for og product tags */
  price?: { amount: number; currency?: string };
  noindex?: boolean;
  /** Show the lily curtain on first visit (home only by default). */
  intro?: boolean;
  bodyClass?: string;
}
const {
  title, description = site.description, image = '/og.jpg', imageAlt, imageWidth = 1200, imageHeight = 630,
  type = 'website', schema = [], pageType, price, noindex = false, intro = false, bodyClass,
} = Astro.props;
// Short brand suffix keeps titles inside Google's ~60-character display.
const fullTitle = title ? `${title} | Incandescent Lily` : 'Incandescent Lily | Black-Owned, Plant-Based Body Care';
// Clean, extension-free canonical path ("/shop.html" -> "/shop", "/index" -> "/").
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = abs(path === '/' ? '/' : path.replace(/\/$/, ''));
const ogImage = abs(image);
const ld = graph(webPage({ path, name: fullTitle, description, type: pageType, image }), ...schema);
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f7f2eb" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />}

    <!-- icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="IL Collection" />
    <meta name="application-name" content="IL Collection" />

    <!-- fonts the first paint needs -->
    <link rel="preload" href={cormorant300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostVar} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / social -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt ?? `${site.name} — plant-based body care`} />
    {price && <meta property="product:price:amount" content={price.amount.toFixed(2)} />}
    {price && <meta property="product:price:currency" content={price.currency ?? 'USD'} />}
    {price && <meta property="product:availability" content="in stock" />}
    {price && <meta property="product:brand" content={site.name} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? `${site.name} — plant-based body care`} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline define:vars={{ intro }}>
      document.documentElement.classList.add('js');
      try { if (!intro || sessionStorage.getItem('ilc-intro')) document.documentElement.classList.add('intro-seen'); } catch (e) { document.documentElement.classList.add('intro-seen'); }
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    {intro && <div class="preloader" data-preloader aria-hidden="true">
      <div class="preloader__inner">
        <div class="preloader__lily"><img src="/media/brand/lily-mark.png" alt="" width="524" height="512" /></div>
        <p class="preloader__word"><span>Incandescent</span> <em>Lily</em></p>
      </div>
    </div>}

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="glow-cursor" data-glow aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/motion';
      import '../scripts/interactions';
    </script>

    <style>
      .preloader {
        position: fixed; inset: 0; z-index: 300;
        display: grid; place-items: center;
        background: var(--bone);
      }
      :global(html:not(.js)) .preloader,
      :global(html.intro-seen) .preloader { display: none; }
      .preloader__inner { display: grid; justify-items: center; gap: 1.4rem; }
      .preloader__lily { width: 96px; clip-path: inset(100% 0 0 0); }
      .preloader__lily img { width: 100%; height: auto; }
      .preloader__word {
        font-family: var(--serif); font-weight: 300; font-size: clamp(1.6rem, 4vw, 2.4rem);
        letter-spacing: 0.32em; text-transform: uppercase; overflow: hidden; padding-left: 0.32em;
      }
      .preloader__word span, .preloader__word em { display: inline-block; transform: translateY(110%); }
      .preloader__word em { font-style: italic; color: var(--lily); text-transform: none; letter-spacing: 0.04em; }
      /* safety: never trap visitors behind the curtain */
      :global(html.js:not(.motion-ready)) .preloader { animation: preloader-out 0.6s 3s forwards; }
      @keyframes preloader-out { to { opacity: 0; visibility: hidden; } }
    </style>
  </body>
</html>
