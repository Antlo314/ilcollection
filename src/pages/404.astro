---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="nf" data-hero>
    <div class="wrap nf__inner">
      <img src="/media/brand/lily-mark.png" alt="" width="524" height="512" class="nf__lily" data-reveal />
      <p class="eyebrow eyebrow--plain" data-reveal>404</p>
      <h1 class="display" data-split>This path has <em>wandered off.</em></h1>
      <p class="lead" data-reveal>The page you’re looking for may have moved. Let’s guide you back to the garden.</p>
      <div class="nf__ctas" data-reveal>
        <a href="/shop" class="btn" data-magnetic>Explore the Collection <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/" class="link-line">Return home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; place-items: center; padding: calc(var(--top-h) + 3rem) 0 4rem; }
  .nf__inner { display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .nf__inner h1 { max-width: 14ch; }
  .nf__lily { width: 72px; height: auto; }
  .nf__ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 2rem; margin-top: 0.5rem; }
</style>
