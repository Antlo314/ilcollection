---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import ProductCard from '../components/ProductCard.astro';
import Marquee from '../components/Marquee.astro';
import { media, bySlug, firstImage, priceLabel, values, mission, faqs, site } from '../data/site';

const b = media.brand;
const v = media.video;

const mostLoved = [
  'enlighten-mist', 'garden-restore-teas', 'lip-love-balm', 'woke-body-oil', 'brightstar-glow-bar',
  'awaken-healing-candle', 'favor-face-serum', 'lemongrass-growth-mist', 'brightstar-cleanser', 'manuka-honey-mask',
].map(bySlug);

const rituals = ['incandescent-luxe-box', 'glow-grow-duo', 'woke-his-hers-set', 'four-step-miracle-kit'].map(bySlug);

const pillars = [
  {
    word: 'Spirit', img: b.lifeTeaBible, alt: 'An open Bible and journal beside a cup of Garden Restoré tea',
    copy: 'Light the Awaken™ candle, steep a cup of tea, and open a 30-day devotional — moments of reflection, prayer, and rest.',
    links: [{ href: '/shop?c=devotional', label: 'Devotionals' }, { href: '/shop/awaken-healing-candle', label: 'Awaken Candle' }],
  },
  {
    word: 'Mind', img: b.lifeMistsTray, alt: 'Three Enlighten Mist bottles on a stone tray with eucalyptus',
    copy: 'Layered aromas and potent herbal blends that bring calm, clarity, and quiet sophistication to every space you move through.',
    links: [{ href: '/shop/enlighten-mist', label: 'Enlighten Mist' }, { href: '/shop/garden-restore-teas', label: 'Teas' }],
  },
  {
    word: 'Body', img: b.lifeLocs, alt: 'A woman with long locs misting her hair with Lemongrass Growth & Refresher Mist',
    copy: 'Healing botanicals, butters, and oils that nurture skin and hair — from eczema-prone skin to locs, curls, and beards.',
    links: [{ href: '/shop?c=skin', label: 'Skin' }, { href: '/shop?c=hair', label: 'Hair' }],
  },
];

const results = [
  { img: b.resultsNeck, title: 'Whole Body Healing Salve', note: '3 weeks · twice daily', href: '/shop/whole-body-healing-salve' },
  { img: b.resultsGlowBar, title: 'Brightstar™ Manuka Honey Glow Bar', note: '3-day transformation', href: '/shop/brightstar-glow-bar' },
  { img: b.resultsAcne, title: '4-Step Miracle Kit', note: 'Results of 40 days', href: '/shop/four-step-miracle-kit' },
  { img: b.resultsHair, title: 'Lemongrass Growth & Refresher Mist™', note: '10 months of use', href: '/shop/lemongrass-growth-mist' },
  { img: b.resultsBrows, title: 'Whole Body Healing Salve', note: '3 weeks · twice daily', href: '/shop/whole-body-healing-salve' },
];

const blends = [
  { name: 'Vital Balance™', note: 'Moroccan green tea for daily balance, natural energy & skin radiance' },
  { name: 'Revive Essence™', note: 'Rhodiola & gotu kola for clarity, focus & balanced energy' },
  { name: 'Metabolic Blossom™', note: 'A gentle daily detox to support digestion & ease bloating' },
  { name: 'Sacred Stillness™', note: 'A calming nighttime blend for deep, peaceful rest' },
  { name: 'Eve’s Ease™', note: 'A restorative women’s blend for monthly & midlife balance' },
];

const gallery = [
  { img: b.lifeLip, alt: 'A smiling woman applying Lip Love balm', label: 'Lip Love™', href: '/shop/lip-love-balm', speed: 0.12 },
  { img: b.lifeBeard, alt: 'A man misting his beard with Lemongrass mist', label: 'Beard care', href: '/shop/lemongrass-growth-mist', speed: -0.1 },
  { img: b.lifeLinen, alt: 'A woman misting her bed linens before rest', label: 'Linen mist for deeper rest', href: '/shop/lemongrass-growth-mist', speed: 0.18 },
  { img: b.lifeTowel, alt: 'A woman wearing the Manuka Honey mask', label: 'Manuka Honey Mask', href: '/shop/manuka-honey-mask', speed: -0.06 },
  { img: b.lifeLipHim, alt: 'A man applying Lip Love balm', label: 'Lip Love™ for him', href: '/shop/lip-love-balm', speed: 0.1 },
  { img: b.lifeCleanser, alt: 'Brightstar cleanser bottles on a wooden tray', label: 'Brightstar™ Cleanser', href: '/shop/brightstar-cleanser', speed: -0.14 },
];

const reign = bySlug('reign-sanitary-napkins');
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero" data-hero>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal>Plant-based wellness &amp; body care</p>
        <h1 class="h1" data-split>Rooted in <em>purity.</em> Crafted with <em>purpose.</em></h1>
        <p class="lead" data-reveal>Luxurious body care made from the plants given to us by God — for the way you nurture your spirit, mind, and body.</p>
        <div class="hero__ctas" data-reveal>
          <a href="/shop" class="btn" data-magnetic>Shop the Collection <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/our-story" class="link-line">Our Story</a>
        </div>
      </div>

      <div class="hero__art">
        <div class="hero__arch halo">
          <div class="frame frame--arch" data-clip>
            <Img media={b.lifeCleanser} alt="Brightstar Manuka Honey Cleanser on a wooden tray with lavender and eucalyptus" sizes="(max-width: 960px) 80vw, 34vw" eager />
          </div>
        </div>
        <div class="hero__inset frame frame--soft" data-clip>
          <Img media={b.lifeMistsTray} alt="Enlighten Mist trio" sizes="(max-width: 960px) 40vw, 16vw" eager />
        </div>
        <div class="badge" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="badge__ring" data-spin>
            <defs><path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
            <text><textPath href="#badge-circle" textLength="486" lengthAdjust="spacing">100% Plant-Based ✦ Black-Owned ✦ Small Batch ✦</textPath></text>
          </svg>
          <img src="/media/brand/lily-mark.png" alt="" width="524" height="512" class="badge__lily" />
        </div>
      </div>
    </div>
    <a href="#loved" class="scroll-cue" aria-label="Scroll to the collection"><span></span></a>
  </section>

  <Marquee items={values} />

  <!-- ============ MOST LOVED ============ -->
  <section class="section" id="loved">
    <div class="wrap section-head">
      <div>
        <p class="eyebrow" data-reveal>Most Loved</p>
        <h2 class="h2" data-split>Rituals our community <em>returns to.</em></h2>
      </div>
      <div class="section-head__aside" data-reveal>
        <div class="rail-nav">
          <button class="rail-btn" type="button" data-rail-prev aria-label="Previous products">←</button>
          <button class="rail-btn" type="button" data-rail-next aria-label="Next products">→</button>
        </div>
        <a href="/shop" class="link-line">Shop all</a>
      </div>
    </div>
    <div class="rail" data-rail data-drag-scroll>
      {mostLoved.map((p, i) => (
        <div class="rail__item" data-reveal>
          <ProductCard product={p} sizes="(max-width: 640px) 75vw, (max-width: 1100px) 40vw, 24vw" eager={i < 2} />
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SPIRIT · MIND · BODY ============ -->
  <section class="section bg-linen pillars">
    <div class="wrap">
      <div class="pillars__head">
        <p class="eyebrow" data-reveal>Holistic by design</p>
        <h2 class="display" data-split>True beauty is nurtured in <em>spirit, mind &amp; body.</em></h2>
      </div>
      <div class="pillars__grid">
        {pillars.map((p, i) => (
          <article class="pillar" style={`--i:${i}`}>
            <div class="frame frame--arch pillar__img" data-clip data-parallax-scope>
              <div data-parallax="0.12" class="pillar__parallax">
                <Img media={p.img} alt={p.alt} sizes="(max-width: 860px) 90vw, 30vw" />
              </div>
            </div>
            <p class="pillar__num" data-reveal>0{i + 1}</p>
            <h3 class="pillar__word" data-reveal>{p.word}</h3>
            <p class="pillar__copy" data-reveal>{p.copy}</p>
            <div class="pillar__links" data-reveal>
              {p.links.map((l) => <a href={l.href} class="link-line">{l.label}</a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="section bg-plum mission" data-glow-zone>
    <div class="mission__glow" aria-hidden="true"></div>
    <div class="wrap mission__inner">
      <div class="divider-lily" data-reveal><img src="/media/brand/lily-mark-honey.png" alt="" width="524" height="512" /></div>
      <p class="eyebrow eyebrow--plain mission__eyebrow" data-reveal>The ILC Mission</p>
      <p class="mission__text" data-lightup>{mission}</p>
      <ul class="mission__values" role="list">
        <li data-reveal>
          <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><circle cx="24" cy="24" r="17"/><path d="M24 12v24M16 20l8-8 8 8"/></svg>
          <span>Zero Waste</span>
        </li>
        <li data-reveal>
          <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M24 40c0-12 4-22 14-28-12 0-22 8-22 20 0 3 1 5 2 7"/><path d="M24 40c-3-6-8-10-14-11"/></svg>
          <span>Vegan</span>
        </li>
        <li data-reveal>
          <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M17 14l7-6 7 6M24 8v14"/><path d="M38 26l-2 9-9 1"/><path d="M36 35c-6-1-10-5-12-11"/><path d="M10 26l2 9 9 1"/><path d="M12 35c6-1 10-5 12-11"/></svg>
          <span>Recyclable</span>
        </li>
        <li data-reveal>
          <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M6 28l8-8 6 3 6-5 6 2 10 8"/><path d="M14 20l-4 10 10 8c2 1 4 1 6 0l12-10"/><path d="M20 30l4 3M24 27l5 3"/></svg>
          <span>Fair Trade</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ TEXTURES ============ -->
  <section class="section textures">
    <div class="wrap textures__grid">
      <div class="textures__film frame frame--soft" data-expand>
        <video src={v['manuka-pour'].src} poster={v['manuka-pour'].poster} autoplay muted loop playsinline preload="metadata" aria-label="Manuka honey mask being poured into a jar"></video>
      </div>
      <div class="textures__copy">
        <p class="eyebrow" data-reveal>Handmade in small batches</p>
        <h2 class="h2" data-split>Raw honey. Botanical oils. <em>Pure intention.</em></h2>
        <p class="lead" data-reveal>Every order is prepared in small batches with care and intention, so you receive each formula in its purest form — velvety, potent, and alive.</p>
        <div class="textures__drop" data-reveal>
          <div class="frame textures__circle">
            <video src={v['oil-drop'].src} poster={v['oil-drop'].poster} autoplay muted loop playsinline preload="metadata" aria-label="A golden drop of Brightstar cleanser"></video>
          </div>
          <p><span class="eyebrow eyebrow--plain">Brightstar™ Cleanser</span><br />Manuka honey + turmeric, gentle enough for daily use.</p>
        </div>
        <a href="/shop/manuka-honey-mask" class="btn btn--ghost" data-reveal data-magnetic>Discover the Manuka Mask <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ RITUALS (pinned horizontal) ============ -->
  <section class="rituals bg-linen" data-hscroll>
    <div class="rituals__track" data-hscroll-track>
      <div class="rituals__intro">
        <p class="eyebrow" data-reveal>Bundle &amp; Save</p>
        <h2 class="display" data-split>Rituals, <em>curated.</em></h2>
        <p class="lead" data-reveal>Thoughtfully curated kits that turn your daily routine into a spa-like experience at home — and make a beautiful gift.</p>
        <a href="/shop?c=rituals" class="link-line" data-reveal>All rituals &amp; sets</a>
      </div>
      {rituals.map((p, i) => (
        <a href={`/shop/${p.slug}`} class="ritual" data-hscroll-item>
          <div class="ritual__media frame frame--soft">
            <Img media={firstImage(p)} alt={p.name} sizes="(max-width: 960px) 85vw, 40vw" />
            {p.ribbon && <span class="ribbon ritual__ribbon">{p.ribbon}</span>}
          </div>
          <div class="ritual__meta">
            <span class="ritual__num">0{i + 1}</span>
            <div>
              <h3 class="h3">{p.name}</h3>
              <p class="muted">{p.sub}</p>
            </div>
            <span class="ritual__price">{priceLabel(p)}</span>
          </div>
        </a>
      ))}
    </div>
    <div class="rituals__progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </section>

  <!-- ============ RESULTS ============ -->
  <section class="section results">
    <div class="wrap section-head">
      <div>
        <p class="eyebrow" data-reveal>Real skin, real stories</p>
        <h2 class="h2" data-split>Results that <em>speak softly</em> — and last.</h2>
      </div>
      <p class="section-head__note muted" data-reveal>Shared by our customers. Individual results vary with consistent use.</p>
    </div>
    <div class="rail rail--results" data-drag-scroll>
      {results.map((r) => (
        <a href={r.href} class="result" data-reveal>
          <div class="frame frame--soft result__img">
            <Img media={r.img} alt={`Before and after: ${r.title}, ${r.note}`} sizes="(max-width: 640px) 80vw, 30vw" />
          </div>
          <p class="result__note eyebrow eyebrow--plain">{r.note}</p>
          <h3 class="result__title">{r.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ GARDEN RESTORÉ ============ -->
  <section class="section bg-linen garden">
    <div class="wrap garden__grid">
      <div class="garden__media" data-parallax-scope>
        <div class="frame frame--soft garden__main" data-clip>
          <div data-parallax="0.14" class="garden__parallax">
            <Img media={b.lifeTeaBible} alt="An open Bible and notebook beside a glass cup of herbal tea" sizes="(max-width: 960px) 92vw, 50vw" />
          </div>
        </div>
        <div class="garden__pouch halo" data-reveal>
          <Img media={b.teaPouch} alt="Garden Restoré tea pouch with a steeped cup" sizes="(max-width: 960px) 50vw, 22vw" />
        </div>
      </div>
      <div class="garden__copy">
        <p class="eyebrow" data-reveal>Garden Restoré™ Teas</p>
        <h2 class="h2" data-split>Restoration begins in <em>the Garden.</em></h2>
        <p class="lead" data-reveal>Potent blends of raw roots, leaves, and bark — carefully cut, sifted, and cleansed, then sealed in organic corn-fiber sachets.</p>
        <ol class="blends" role="list">
          {blends.map((bl, i) => (
            <li data-reveal>
              <span class="blends__num">0{i + 1}</span>
              <span class="blends__name">{bl.name}</span>
              <span class="blends__note">{bl.note}</span>
            </li>
          ))}
        </ol>
        <a href="/shop/garden-restore-teas" class="btn" data-reveal data-magnetic>Explore the blends <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ GALLERY ============ -->
  <section class="section gallery">
    <div class="wrap">
      <div class="gallery__head">
        <p class="eyebrow" data-reveal>For every crown</p>
        <h2 class="display" data-split>Every texture, <em>every tone.</em></h2>
        <p class="lead" data-reveal>Gentle yet effective for locs, braids, curls, beards, and sensitive skin — plant-based blends that adapt to your body’s natural rhythms.</p>
      </div>
      <div class="gallery__grid">
        {gallery.map((g) => (
          <a href={g.href} class="gallery__item" data-parallax-scope>
            <div class="frame frame--soft" data-clip>
              <div data-parallax={String(Math.abs(g.speed))} class="gallery__parallax">
                <Img media={g.img} alt={g.alt} sizes="(max-width: 700px) 50vw, 32vw" />
              </div>
            </div>
            <span class="gallery__label">{g.label} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ REIGN ============ -->
  <section class="reign">
    <div class="wrap reign__grid">
      <div class="reign__copy">
        <span class="ribbon">HSA Eligible</span>
        <h2 class="h2" data-split>Feminine wellness, <em>made pure.</em></h2>
        <p class="lead" data-reveal>Reign pads are all-natural and ultra-thin, designed without harmful chemicals or fragrances — with a super-soft top layer, high leak guards, and a graphene mineral strip.</p>
        <div class="reign__row" data-reveal>
          <a href={`/shop/${reign.slug}`} class="btn" data-magnetic>Shop Reign <span class="arrow" aria-hidden="true">→</span></a>
          <span class="muted">{priceLabel(reign)}</span>
        </div>
      </div>
      <div class="frame frame--soft reign__img" data-clip>
        <Img media={b.lifeReignStack} alt="A stack of Reign sanitary napkin packs in soft pastel colors" sizes="(max-width: 960px) 92vw, 46vw" />
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section faq">
    <div class="wrap faq__grid">
      <div>
        <p class="eyebrow" data-reveal>Good to know</p>
        <h2 class="h2" data-split>Questions, <em>answered.</em></h2>
        <p class="lead" data-reveal>Still wondering? We’re here Monday through Friday.</p>
        <a href="/contact" class="link-line" data-reveal>Contact customer care</a>
      </div>
      <div class="accordion" data-reveal>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <div class="panel"><div class="panel-inner prose"><p>{f.a}</p></div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ COMMUNITY ============ -->
  <section class="section--tight community">
    <div class="wrap community__inner">
      <p class="eyebrow eyebrow--plain" data-reveal>Join the community</p>
      <a href={site.social.instagram} target="_blank" rel="noopener" class="community__handle" data-split>{site.handle}</a>
      <div class="community__links" data-reveal>
        <a href={site.social.instagram} target="_blank" rel="noopener" class="btn btn--ghost">Instagram</a>
        <a href={site.social.tiktok} target="_blank" rel="noopener" class="btn btn--ghost">TikTok</a>
        <a href={site.social.facebook} target="_blank" rel="noopener" class="btn btn--ghost">Facebook</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; padding: calc(var(--header-h) + 34px + clamp(2rem, 6vh, 5rem)) 0 clamp(3rem, 8vh, 6rem); display: flex; align-items: center; }
  .hero__grid { display: grid; grid-template-columns: 1.08fr 0.92fr; align-items: center; gap: clamp(2rem, 5vw, 6rem); }
  .hero__copy { display: grid; gap: clamp(1.4rem, 2.6vw, 2.2rem); justify-items: start; }
  .hero__copy .lead { max-width: 34ch; }
  .hero__ctas { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .hero__art { position: relative; padding: 4% 8% 10% 12%; }
  .hero__arch .frame { aspect-ratio: 3 / 4; }
  .hero__inset { position: absolute; left: 0; bottom: 2%; width: 40%; aspect-ratio: 1; border: 6px solid var(--bone); border-radius: 50%; }
  .badge { position: absolute; right: 0; top: 0; width: clamp(110px, 11vw, 150px); aspect-ratio: 1; display: grid; place-items: center; }
  .badge__ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .badge__ring text { font-family: var(--sans); font-size: 13.4px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; fill: var(--ink); }
  .badge__lily { width: 38%; height: auto; }
  .badge::before { content: ''; position: absolute; inset: 8%; border-radius: 50%; background: var(--bone); box-shadow: 0 10px 40px -20px rgba(42, 25, 50, 0.4); z-index: -1; }
  .scroll-cue { position: absolute; left: 50%; bottom: 1.6rem; width: 1px; height: 54px; overflow: hidden; background: rgba(34, 23, 39, 0.14); }
  .scroll-cue span { position: absolute; inset: 0; background: var(--ink); animation: cue 2.4s var(--ease-soft) infinite; }
  @keyframes cue { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }

  /* ---------- section heads & rails ---------- */
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: clamp(2.4rem, 5vw, 4rem); }
  .section-head h2 { margin-top: 1.1rem; max-width: 15ch; }
  .section-head__aside { display: flex; align-items: center; gap: 2rem; flex: none; }
  .section-head__note { max-width: 30ch; font-size: 0.9rem; }
  .rail-nav { display: flex; gap: 0.5rem; }
  .rail-btn { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(34, 23, 39, 0.2); transition: background 0.4s, color 0.4s, border-color 0.4s; }
  .rail-btn:hover { background: var(--ink); color: var(--bone); border-color: var(--ink); }
  .rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(250px, 23vw, 340px); gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding-bottom: 0.5rem;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail > * { scroll-snap-align: start; }
  .rail.is-dragging { scroll-snap-type: none; cursor: grabbing; }
  .rail.is-dragging a { pointer-events: none; }

  /* ---------- pillars ---------- */
  .pillars__head { text-align: center; display: grid; justify-items: center; gap: 1.4rem; margin-bottom: clamp(3rem, 6vw, 5.5rem); }
  .pillars__head h2 { max-width: 17ch; }
  .pillars__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); }
  .pillar { display: grid; gap: 0.8rem; align-content: start; }
  .pillar:nth-child(2) { margin-top: clamp(0rem, 6vw, 6rem); }
  .pillar__img { aspect-ratio: 4 / 5; margin-bottom: 1.4rem; }
  .pillar__parallax { position: absolute; inset: -10% 0; }
  .pillar__parallax :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pillar:first-child .pillar__parallax :global(img) { object-position: 18% 50%; }
  .pillar__num { font-size: 0.72rem; letter-spacing: 0.2em; color: var(--honey); font-weight: 500; }
