---
import { site, collections } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer bg-plum" data-glow-zone>
  <div class="wrap footer__top">
    <div class="footer__intro">
      <img src="/media/brand/logo-light.png" alt={site.name} width="640" height="216" class="footer__logo" loading="lazy" />
      <p class="footer__line">Wellness and body care rooted in purity, purpose, and divine intention.</p>
      <div class="footer__social">
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
        </a>
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5Z"/></svg>
        </a>
        <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.8 2.2 4.6 5 5"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Shop">
      <p class="eyebrow eyebrow--plain">Shop</p>
      {collections.map((c) => <a href={c.key === 'all' ? '/shop' : `/shop?c=${c.key}`}>{c.key === 'all' ? 'The Collection' : c.label}</a>)}
    </nav>

    <nav class="footer__col" aria-label="Care">
      <p class="eyebrow eyebrow--plain">Care</p>
      <a href="/our-story">Our Story</a>
      <a href="/contact">Contact &amp; FAQ</a>
      <a href="/shipping-returns">Shipping &amp; Returns</a>
      <a href="https://www.nebaministry.org/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>
      <a href="https://www.nebaministry.org/copy-of-privacy-policy" target="_blank" rel="noopener">Terms &amp; Conditions</a>
    </nav>

    <div class="footer__col">
      <p class="eyebrow eyebrow--plain">Customer Care</p>
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <p class="footer__hours">{site.hours}</p>
    </div>
  </div>

  <div class="footer__mark" aria-hidden="true">
    <span data-footer-word>Incandescent</span>
  </div>

  <div class="wrap footer__bottom">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>A <a href={site.ministryUrl} target="_blank" rel="noopener">NEBA Ministry &amp; Mentorship</a> collection <span aria-hidden="true">✦</span> Black-owned</p>
  </div>
</footer>

<style>
  .footer { position: relative; overflow: hidden; padding-top: clamp(4.5rem, 8vw, 8rem); }
  .footer__top {
    display: grid; gap: 3rem 2rem;
    grid-template-columns: 1.6fr repeat(3, 1fr);
  }
  .footer__logo { width: 220px; height: auto; margin-bottom: 1.6rem; }
  .footer__line { font-family: var(--serif); font-size: 1.5rem; font-weight: 300; line-height: 1.3; max-width: 22ch; color: rgba(247, 242, 235, 0.86); }
  .footer__social { display: flex; gap: 0.6rem; margin-top: 1.8rem; }
  .footer__social a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    border: 1px solid rgba(247, 242, 235, 0.22); transition: background 0.4s, color 0.4s, border-color 0.4s;
  }
  .footer__social a:hover { background: var(--honey-soft); color: var(--plum); border-color: var(--honey-soft); }
  .footer__col { display: flex; flex-direction: column; gap: 0.7rem; font-size: 0.92rem; color: rgba(247, 242, 235, 0.72); }
  .footer__col .eyebrow { margin-bottom: 0.6rem; }
  .footer__col a { width: fit-content; transition: color 0.3s; }
  .footer__col a:hover { color: var(--honey-soft); }
  .footer__hours { font-size: 0.85rem; color: rgba(247, 242, 235, 0.5); }

  .footer__mark {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    font-family: var(--serif); font-weight: 300; font-style: italic;
    font-size: clamp(4rem, 17.5vw, 19rem); line-height: 0.8; letter-spacing: -0.03em;
    text-align: center; white-space: nowrap;
    background: linear-gradient(180deg, rgba(234, 210, 164, 0.55), rgba(234, 210, 164, 0.04) 85%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    user-select: none;
  }
  .footer__mark span { display: inline-block; }
  .footer__bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.8rem 2rem;
    padding-block: 1.6rem 2rem; margin-top: -1px;
    border-top: 1px solid rgba(247, 242, 235, 0.12);
    font-size: 0.78rem; color: rgba(247, 242, 235, 0.55);
  }
  .footer__bottom a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(247, 242, 235, 0.3); }
  .footer__bottom a:hover { color: var(--honey-soft); }
  .footer__bottom span { color: var(--honey-soft); margin: 0 0.35em; }

  @media (max-width: 960px) {
    .footer__top { grid-template-columns: 1fr 1fr; }
    .footer__intro { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer__top { grid-template-columns: 1fr; }
  }
</style>
